# Copy this file to .env and fill in your API keys
# Or enter them directly in the app sidebar (🔑 LLM Provider Settings → API Keys).
# Add as many as you like — with "Auto-fallback" on, the app retries on the
# next provider when one is rate-limited or down.

# Google Gemini API Key (get one at https://aistudio.google.com/apikey)
GEMINI_API_KEY=""

# Groq API Key (get one at https://console.groq.com/keys)
GROQ_API_KEY=""

# OpenRouter API Key (get one at https://openrouter.ai/keys)
OPENROUTER_API_KEY=""

# Ollama Cloud API Key (get one at https://ollama.com/settings/keys)
OLLAMA_API_KEY=""

# Local Ollama server (only used with the "Ollama (Local LLM)" provider)
OLLAMA_BASE_URL="http://localhost:11434"

# Where flashcard decks, reviews and quiz history are saved (optional)
# STUDY_DB_PATH="data/study.db"

# Wolfram Alpha API Key (optional, for math queries)
WOLFRAM_API_KEY=""
